        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszerre többet is húzhat ide. A `com.apple.quarantine` attribútum\nmindegyikről el lesz távolítva, a bennük lévő összes elemmel együtt."
          }
        },
        "id" : {
          "stringUnit" : {
