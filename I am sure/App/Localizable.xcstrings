    "Several at once is fine. The `com.apple.quarantine` attribute\nwill be removed from each one, including everything inside." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إفلات عدة عناصر دفعة واحدة. ستتم إزالة السمة `com.apple.quarantine`\nمن كل عنصر، بما في ذلك كل ما بداخله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Може да пуснете няколко наведнъж. Атрибутът `com.apple.quarantine`\nще бъде премахнат от всеки от тях, включително от цялото му съдържание."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথে কয়েকটিও দিতে পারেন। প্রতিটি থেকে `com.apple.quarantine` অ্যাট্রিবিউট\nসরানো হবে, এর ভিতরের সবকিছু সহ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots deixar-ne anar diversos alhora. L’atribut `com.apple.quarantine`\nse suprimirà de cadascun, inclòs tot el que contenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete jich vybrat několik najednou. Atribut `com.apple.quarantine`\nbude odebrán z každé položky včetně všeho, co obsahuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan lægge flere ad gangen. Attributten `com.apple.quarantine`\nfjernes fra hvert enkelt, inklusive alt indeni."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mehrere auf einmal ablegen. Das Attribut `com.apple.quarantine`\nwird von jedem Objekt entfernt, einschließlich aller enthaltenen Inhalte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να αφήσετε πολλά ταυτόχρονα. Το χαρακτηριστικό `com.apple.quarantine`\nθα καταργηθεί από κάθε ένα, μαζί με όλα όσα περιέχει."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several at once is fine. The `com.apple.quarantine` attribute\nwill be removed from each one, including everything inside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes soltar varios a la vez. El atributo `com.apple.quarantine`\nse quitará de cada uno, incluido todo su contenido."
