        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бірнешеуін бірден қосуға болады. `com.apple.quarantine` атрибуты\nәрқайсысынан, ішіндегінің бәрімен қоса, алынады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಮ್ಮೆಗೆ ಹಲವನ್ನೂ ಬಿಡಬಹುದು. ಪ್ರತಿಯೊಂದರಿಂದಲೂ `com.apple.quarantine` ಗುಣಲಕ್ಷಣವನ್ನು\nಅದರೊಳಗಿನ ಎಲ್ಲದರ ಸಹಿತ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 여러 개를 선택해도 됩니다. 각 항목과 그 안의 모든 항목에서\n`com.apple.quarantine` 속성이 제거됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galima kelis iš karto. Atributas `com.apple.quarantine`\nbus pašalintas iš kiekvieno, įskaitant visą jo turinį."
