    "Removing it skips that check. Only do this for apps and files you trust, from a source you know." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي إزالته إلى تخطي هذا الفحص. افعل ذلك فقط مع التطبيقات والملفات التي تثق بها ومن مصدر تعرفه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако я премахнете, тази проверка се пропуска. Правете го само за приложения и файлове, на които имате доверие, от източник, който познавате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po jejím odebrání se tato kontrola přeskočí. Dělejte to jen u aplikací a souborů, kterým důvěřujete a které pocházejí ze známého zdroje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du fjerner den, springes denne kontrol over. Gør kun dette med apps og filer, du har tillid til, fra en kilde, du kender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du sie entfernst, wird diese Prüfung übersprungen. Tu das nur bei Apps und Dateien, denen du vertraust und die aus einer dir bekannten Quelle stammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κατάργησή του παρακάμπτει αυτόν τον έλεγχο. Κάντε το μόνο για εφαρμογές και αρχεία που εμπιστεύεστε, από πηγή που γνωρίζετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitarla, se omite esa comprobación. Hazlo solo con apps y archivos de confianza, procedentes de una fuente que conozcas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen ohittaa tämän tarkistuksen. Tee tämä vain apeille ja tiedostoille, joihin luotat ja jotka ovat peräisin tuntemastasi lähteestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous la retirez, cette vérification est ignorée. Ne le faites que pour des apps et des fichiers de confiance, provenant d’une source que vous connaissez."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a retiras, omítese esa comprobación. Fai isto só con apps e ficheiros nos que confíes e que procedan dunha fonte que coñezas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרתו מדלגת על הבדיקה הזו. עשו זאת רק עבור אפליקציות וקבצים שאתם סומכים עליהם, ממקור מוכר לכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाने पर वह जाँच छूट जाती है। ऐसा केवल उन्हीं ऐप्स और फ़ाइलों के लिए करें जिन पर आप भरोसा करते हैं और जो किसी जाने-पहचाने स्रोत से आई हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanjem se ta provjera preskače. Učini to samo za aplikacije i datoteke kojima vjeruješ, iz izvora koji poznaješ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolításával ez az ellenőrzés kimarad. Csak olyan appokkal és fájlokkal tegye ezt meg, amelyekben megbízik, és ismert forrásból származnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovendola, questo controllo viene saltato. Fallo solo per app e file di cui ti fidi, provenienti da una fonte che conosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隔離を解除すると、このチェックが省略されます。信頼できるAppやファイル、提供元がわかっているものにのみ行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격리를 해제하면 이 검사가 생략됩니다. 신뢰할 수 있는 앱과 파일, 출처를 알고 있는 경우에만 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du fjerner den, hoppes denne kontrollen over. Gjør dette bare for apper og filer du stoler på, fra en kilde du kjenner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de quarantaine verwijdert, wordt die controle overgeslagen. Doe dit alleen voor apps en bestanden die je vertrouwt, van een bron die je kent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie jej pomija to sprawdzenie. Rób to tylko dla aplikacji i plików, którym ufasz, pochodzących ze znanego Ci źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removê-la ignora essa verificação. Faça isso apenas com apps e arquivos em que você confia, de uma fonte que você conhece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao removê-la, essa verificação é ignorada. Faça-o apenas para apps e ficheiros em que confia, de uma origem que conhece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă o eliminați, această verificare este omisă. Faceți acest lucru doar pentru aplicații și fișiere în care aveți încredere, dintr-o sursă pe care o cunoașteți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если снять карантин, эта проверка будет пропущена. Делайте это только для приложений и файлов, которым вы доверяете, из известного вам источника."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej odstránením sa táto kontrola preskočí. Rob to iba pri aplikáciách a súboroch, ktorým dôveruješ a ktoré pochádzajú zo známeho zdroja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če jo odstraniš, se to preverjanje preskoči. To naredi samo za aplikacije in datoteke, ki jim zaupaš in izvirajo iz vira, ki ga poznaš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du tar bort den hoppas kontrollen över. Gör detta bara för appar och filer som du litar på, från en källa som du känner till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karantinayı kaldırmak bu kontrolü atlar. Bunu yalnızca güvendiğiniz, kaynağını bildiğiniz uygulamalar ve dosyalar için yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зняття карантину пропускає цю перевірку. Робіть це лише для програм і файлів, яким ви довіряєте, із відомого вам джерела."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gỡ bỏ thuộc tính này sẽ bỏ qua bước kiểm tra đó. Chỉ thực hiện với các ứng dụng và tệp mà bạn tin cậy, từ nguồn mà bạn biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除后将跳过该检查。请仅对你信任且来源可靠的App和文件执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除隔離會略過該項檢查。請僅對你信任且來源明確的 App 和檔案執行此操作。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除之後就會略過呢項檢查。請只對你信任、來源可靠嘅 App 同檔案咁做。"
          }
        }
      }
    },
