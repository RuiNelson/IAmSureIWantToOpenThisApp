    "The original can’t be modified in place. Copy it to a writable location and remove quarantine from the copy?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تعديل الأصل في مكانه. هل تريد نسخه إلى موقع قابل للكتابة وإزالة الحجر عن النسخة؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригиналът не може да бъде променен на място. Да се копира ли на място с право за запис и да се премахне карантината от копието?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মূলটি তার জায়গায় পরিবর্তন করা যাবে না। এটিকে লেখার অনুমতি আছে এমন স্থানে কপি করে কপি থেকে কোয়ারেন্টাইন সরাবেন?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’original no es pot modificar on és. Vols copiar-lo a una ubicació amb permís d’escriptura i eliminar la quarantena de la còpia?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originál nelze změnit přímo. Zkopírovat ho na místo s možností zápisu a odebrat karanténu z kopie?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originalen kan ikke ændres på stedet. Vil du kopiere den til et skrivbart sted og fjerne karantænen fra kopien?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original kann nicht direkt geändert werden. In einen beschreibbaren Ort kopieren und die Quarantäne von der Kopie entfernen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρωτότυπο δεν μπορεί να τροποποιηθεί στη θέση του. Αντιγραφή σε τοποθεσία με δυνατότητα εγγραφής και κατάργηση της καραντίνας από το αντίγραφο;"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original can’t be modified in place. Copy it to a writable location and remove quarantine from the copy?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede modificar el original directamente. ¿Copiarlo a una ubicación con permiso de escritura y quitar la cuarentena de la copia?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede modificar el original directamente. ¿Copiarlo a una ubicación con permiso de escritura y quitar la cuarentena de la copia?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäistä ei voi muokata paikallaan. Kopioidaanko se kirjoitettavaan sijaintiin ja poistetaanko karanteeni kopiosta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’original ne peut pas être modifié sur place. Copier-le vers un emplacement modifiable et retirer la quarantaine de la copie ?"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
