    "Removing it skips that check. Only do this for apps and files you trust, from a source you know." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي إزالته إلى تخطي هذا الفحص. افعل ذلك فقط مع التطبيقات والملفات التي تثق بها ومن مصدر تعرفه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако я премахнете, тази проверка се пропуска. Правете го само за приложения и файлове, на които имате доверие, от източник, който познавате."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সরালে সেই যাচাই এড়িয়ে যাওয়া হয়। শুধুমাত্র আপনার বিশ্বস্ত এবং পরিচিত উৎস থেকে আসা অ্যাপ ও ফাইলের জন্যই এটি করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’elimines, s’omet aquesta comprovació. Fes-ho només amb apps i fitxers de confiança, d’una font que coneguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po jejím odebrání se tato kontrola přeskočí. Dělejte to jen u aplikací a souborů, kterým důvěřujete a které pocházejí ze známého zdroje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du fjerner den, springes denne kontrol over. Gør kun dette med apps og filer, du har tillid til, fra en kilde, du kender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du sie entfernst, wird diese Prüfung übersprungen. Tu das nur bei Apps und Dateien, denen du vertraust und die aus einer dir bekannten Quelle stammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κατάργησή του παρακάμπτει αυτόν τον έλεγχο. Κάντε το μόνο για εφαρμογές και αρχεία που εμπιστεύεστε, από πηγή που γνωρίζετε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing it skips that check. Only do this for apps and files you trust, from a source you know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitarla, se omite esa comprobación. Hazlo solo con apps y archivos de confianza, procedentes de una fuente que conozcas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al quitarla, se omite esa comprobación. Hazlo solo con apps y archivos de confianza, de una fuente que conozcas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen ohittaa tämän tarkistuksen. Tee tämä vain apeille ja tiedostoille, joihin luotat ja jotka ovat peräisin tuntemastasi lähteestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous la retirez, cette vérification est ignorée. Ne le faites que pour des apps et des fichiers de confiance, provenant d’une source que vous connaissez."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a retiras, omítese esa comprobación. Fai isto só con apps e ficheiros nos que confíes e que procedan dunha fonte que coñezas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તેને દૂર કરવાથી તે તપાસ છોડી દેવાય છે. આ ફક્ત તમે વિશ્વાસ કરતા હો અને જાણીતા સ્રોતમાંથી આવેલી ઍપ અને ફાઇલો માટે જ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרתו מדלגת על הבדיקה הזו. עשו זאת רק עבור אפליקציות וקבצים שאתם סומכים עליהם, ממקור מוכר לכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाने पर वह जाँच छूट जाती है। ऐसा केवल उन्हीं ऐप्स और फ़ाइलों के लिए करें जिन पर आप भरोसा करते हैं और जो किसी जाने-पहचाने स्रोत से आई हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanjem se ta provjera preskače. Učini to samo za aplikacije i datoteke kojima vjeruješ, iz izvora koji poznaješ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolításával ez az ellenőrzés kimarad. Csak olyan appokkal és fájlokkal tegye ezt meg, amelyekben megbízik, és ismert forrásból származnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapusnya akan melewati pemeriksaan tersebut. Lakukan ini hanya untuk app dan file yang Anda percayai, dari sumber yang Anda kenal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovendola, questo controllo viene saltato. Fallo solo per app e file di cui ti fidi, provenienti da una fonte che conosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隔離を解除すると、このチェックが省略されます。信頼できるAppやファイル、提供元がわかっているものにのみ行ってください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оны алып тастау бұл тексеруді өткізіп жібереді. Мұны тек өзіңіз сенетін, белгілі көзден алынған қолданбалар мен файлдар үшін жасаңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದನ್ನು ತೆಗೆದುಹಾಕಿದರೆ ಆ ಪರಿಶೀಲನೆ ಬಿಟ್ಟುಹೋಗುತ್ತದೆ. ನೀವು ನಂಬುವ, ತಿಳಿದಿರುವ ಮೂಲದಿಂದ ಬಂದ ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳಿಗೆ ಮಾತ್ರ ಇದನ್ನು ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격리를 해제하면 이 검사가 생략됩니다. 신뢰할 수 있는 앱과 파일, 출처를 알고 있는 경우에만 사용하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jį pašalinus, šis patikrinimas praleidžiamas. Darykite tai tik su programomis ir failais, kuriais pasitikite ir kurių šaltinį žinote."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് നീക്കം ചെയ്യുന്നത് ആ പരിശോധന ഒഴിവാക്കുന്നു. നിങ്ങൾ വിശ്വസിക്കുന്ന, അറിയാവുന്ന ഉറവിടത്തിൽ നിന്നുള്ള ആപ്പുകൾക്കും ഫയലുകൾക്കും മാത്രം ഇത് ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ते काढल्याने ती तपासणी वगळली जाते. हे फक्त तुमचा विश्वास असलेल्या आणि ओळखीच्या स्रोतातून आलेल्या ॲप्स व फाइल्ससाठीच करा."
          }
        },
        "ms" : {
          "stringUnit" : {
