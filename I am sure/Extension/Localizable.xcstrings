    "“I am sure” couldn’t be found. Move it to the Applications folder and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على «أنا متأكد». انقله إلى مجلد التطبيقات وحاول مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Сигурен съм“ не може да бъде намерено. Преместете го в папката „Програми“ и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci „Jsem si jistý“ se nepodařilo najít. Přesuňte ji do složky Aplikace a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Jeg er sikker« blev ikke fundet. Flyt programmet til mappen Programmer, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich bin sicher“ wurde nicht gefunden. Bewege das Programm in den Ordner „Programme“ und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η εύρεση του «Είμαι σίγουρος». Μετακινήστε το στον φάκελο «Εφαρμογές» και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado «Estoy seguro». Muévelo a la carpeta Aplicaciones e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appia “Olen varma” ei löytynyt. Siirrä se Ohjelmat-kansioon ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver « J’en suis sûr ». Déplacez-le dans le dossier Applications, puis réessayez."
