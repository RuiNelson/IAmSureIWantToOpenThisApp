    "Only do this for apps and files you trust, from a source you know." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne le faites que pour des apps et des fichiers de confiance, provenant d’une source que vous connaissez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu das nur bei Apps und Dateien, denen du vertraust und die aus einer dir bekannten Quelle stammen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallo solo per app e file di cui ti fidi, provenienti da una fonte che conosci."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افعل ذلك فقط مع التطبيقات والملفات التي تثق بها ومن مصدر تعرفه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dělejte to jen u aplikací a souborů, kterým důvěřujete a které pocházejí ze známého zdroje."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo solo con apps y archivos de confianza, procedentes de una fuente que conozcas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee tämä vain apeille ja tiedostoille, joihin luotat ja jotka ovat peräisin tuntemastasi lähteestä."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עשו זאת רק עבור אפליקציות וקבצים שאתם סומכים עליהם, ממקור מוכר לכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा केवल उन्हीं ऐप्स और फ़ाइलों के लिए करें जिन पर आप भरोसा करते हैं और जो किसी जाने-पहचाने स्रोत से आई हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるAppやファイル、提供元がわかっているものにのみ行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 앱과 파일, 출처를 알고 있는 경우에만 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør dette bare for apper og filer du stoler på, fra en kilde du kjenner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe dit alleen voor apps en bestanden die je vertrouwt, van een bron die je kent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rób to tylko dla aplikacji i plików, którym ufasz, pochodzących ze znanego Ci źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça isso apenas com apps e arquivos em que você confia, de uma fonte que você conhece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça-o apenas para apps e ficheiros em que confia, de uma origem que conhece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делайте это только для приложений и файлов, которым вы доверяете, из известного вам источника."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör detta bara för appar och filer som du litar på, från en källa som du känner till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu yalnızca güvendiğiniz, kaynağını bildiğiniz uygulamalar ve dosyalar için yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робіть це лише для програм і файлів, яким ви довіряєте, із відомого вам джерела."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請只對你信任、來源可靠嘅 App 同檔案咁做。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请仅对你信任且来源可靠的App和文件执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請僅對你信任且來源明確的 App 和檔案執行此操作。"
          }
        }
      }
    },
