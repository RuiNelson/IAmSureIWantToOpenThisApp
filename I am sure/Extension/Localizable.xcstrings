    "“I am sure” will open and remove the `com.apple.quarantine` attribute from %@, including everything inside:" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« I am sure » va s’ouvrir et retirer l’attribut `com.apple.quarantine` de %@, y compris de tout ce qu’il contient :"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„I am sure“ wird geöffnet und entfernt das Attribut `com.apple.quarantine` von %@, einschließlich aller enthaltenen Inhalte:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am sure” si aprirà e rimuoverà l’attributo `com.apple.quarantine` da %@, compreso tutto ciò che contiene:"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفتح «أنا متأكد» ويزيل السمة `com.apple.quarantine` من %@، بما في ذلك كل ما بداخله:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace „I am sure“ se otevře a odebere atribut `com.apple.quarantine` z položky %@ včetně všeho, co obsahuje:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Estoy seguro» se abrirá y quitará el atributo `com.apple.quarantine` de %@, incluido todo su contenido:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am sure” avautuu ja poistaa `com.apple.quarantine`-attribuutin kohteesta %@, myös kaikesta sen sisällä olevasta:"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“אני בטוח/ה” תיפתח ותסיר את התכונה `com.apple.quarantine` מ-%@, כולל כל מה שבתוכו:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am sure” खुलेगा और %@ से `com.apple.quarantine` एट्रिब्यूट हटा देगा, उसके अंदर की हर चीज़ से भी:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「I am sure」が開き、%@から`com.apple.quarantine`属性を削除します(内部のすべてを含む):"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am sure”가 열리고 %@ 및 그 안의 모든 항목에서 `com.apple.quarantine` 속성을 제거합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Jeg er sikker» åpnes og fjerner egenskapen `com.apple.quarantine` fra %@, inkludert alt som ligger inni:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ik weet het zeker” wordt geopend en verwijdert het kenmerk `com.apple.quarantine` van %@, inclusief alles erin:"
          }
